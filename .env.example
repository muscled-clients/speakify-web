# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://speakify.dev
BETTER_AUTH_URL=https://speakify.dev

# Better-auth secret (generate with `openssl rand -hex 32`)
BETTER_AUTH_SECRET=

# Postgres (Coolify provides DATABASE_URL automatically for linked services)
DATABASE_URL=postgres://user:pass@host:5432/speakify

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_SECRET_KEY_LIVE=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY_TEST=price_...
STRIPE_PRICE_MONTHLY_LIVE=price_...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="Speakify <hello@speakify.dev>"

# Cron secret (Coolify scheduled task calls /api/cron/*)
CRON_SECRET=
